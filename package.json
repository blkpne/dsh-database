{
  "name": "dsh-database",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Manage read-only MySQL, MariaDB, PostgreSQL, SQL Server, Oracle and MongoDB connections through per-connection MCP tools in DeepSeek Harness.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./mcp": "./dist/mcp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/reference.md",
    "docs/examples/ecommerce/README.md",
    "docs/examples/ecommerce/seed.sql",
    "docs/examples/ecommerce/queries.sql",
    "docs/usage.md",
    "docs/compatibility.md",
    "docs/releasing.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/assets/connection-manager.jpg",
    "docs/assets/agent-analysis.jpg"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:mysql": "node --import tsx --test test/integration/mysql.ts",
    "check": "npm run check:docs && npm run typecheck && npm test && npm run test:tooling && npm run build && node scripts/verify-pack.mjs",
    "check:docs": "npm run format:check && npm run release:check && node scripts/verify-docs.mjs",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:profile": "node scripts/test-profile.mjs",
    "test:engines": "node --import tsx --test test/integration/engines.ts",
    "test:docker": "node --import tsx test/docker/run.ts",
    "test:tls": "node --import tsx test/docker/tls.ts",
    "test:tls:protocol": "node --import tsx test/docker/tls.ts --protocol",
    "test:docker:cleanup": "node --import tsx test/docker/run.ts --cleanup",
    "test:agent": "node --import tsx test/evaluation/live.ts",
    "test:ablation": "node --import tsx test/experiments/ablation.ts",
    "test:oracle:metadata": "node --import tsx test/experiments/oracle-metadata.ts",
    "dev:web": "node scripts/dev-web.mjs start",
    "dev:mount": "node scripts/dev-web.mjs mount",
    "test:dev-web": "node --test test/dev-web.test.mjs",
    "test:pack": "node scripts/test-pack.mjs",
    "test:compat": "node scripts/test-pack.mjs --dsh minimum --dsh latest",
    "release:check": "node scripts/verify-release.mjs",
    "release:ready": "node scripts/verify-release.mjs --ready",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "test:tooling": "node --test test/*.test.mjs",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blkpne/dsh-database.git"
  },
  "homepage": "https://github.com/blkpne/dsh-database#readme",
  "bugs": {
    "url": "https://github.com/blkpne/dsh-database/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "mysql",
    "database",
    "mariadb",
    "postgresql",
    "sqlserver",
    "oracle",
    "mongodb"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "mongodb": "7.6.0",
    "mysql2": "3.24.4",
    "node-sql-parser": "5.4.0",
    "oracledb": "7.0.1",
    "pg": "8.23.0",
    "tedious": "20.3.6",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "cross-spawn": "7.0.6",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "react": "^18.3.1",
    "semver": "7.8.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "2.9.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
